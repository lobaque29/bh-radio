# Pegue estes 3 valores em cloud.livekit.io > Settings > Keys
LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Segredo para as rotas /admin (gere um valor aleatório com pelo menos 32 caracteres)
ADMIN_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES

# Código do piloto: substitua por um valor privado (deixe vazio para liberar geral)
ACCESS_CODE=SUBSTITUA_POR_UM_CODIGO_PRIVADO

# WhatsApps bloqueados desde o início, separados por vírgula (só números, com DDI+DDD)
BANNED=

# Origem da interface web; use a URL do Pages e, para desenvolvimento local, localhost.
ALLOWED_ORIGINS=http://localhost:3000
